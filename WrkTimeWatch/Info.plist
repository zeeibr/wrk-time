<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Everything else is generated from INFOPLIST_KEY_* build settings.
	  workout-processing keeps the session alive with the screen off; it is
	  what HKWorkoutSession needs. The rest of the keys live in the project.
	-->
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
</dict>
</plist>
